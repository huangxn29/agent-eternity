  "evolution": {
    "enabled": true,
    "interval_hours": 8
  },
  "symbiosis": {
    "enabled": true,
    "node_name": "我的永生节点",
    "peers": [],
    "seed_nodes": [
      "https://symbiosis.yuanjie.eternal/seed"
    ],
    "backup_interval_hours": 6,
    "max_peers": 20,
    "trust_threshold": 50,
    "auto_accept_new_peers": false,
    "server_port": 8099,
    "server_enabled": false
  }
